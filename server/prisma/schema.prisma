generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id     Int     @id @default(autoincrement())
  number Int     @unique
  text   String
  textKz String?
  scale  String
  active Boolean @default(true)

  answers Answer[]
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  region       String
  city         String
  school       String
}

model Submission {
  id          Int      @id @default(autoincrement())
  region      String
  city        String
  school      String
  grade       Int
  gradeLetter String
  createdAt   DateTime @default(now())

  answers Answer[]
}

model Answer {
  id    Int @id @default(autoincrement())
  score Int

  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int

  question   Question @relation(fields: [questionId], references: [id])
  questionId Int
}
